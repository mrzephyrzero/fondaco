# Fondaco configuration (Phase 0 skeleton — surface grows in later phases)

# Password for the demo Postgres container (compose default: fondaco-dev)
POSTGRES_PASSWORD=fondaco-dev

# The app connects as fondaco_ro (SELECT-only, created by
# demo/dataset/init/03_readonly_role.sql; demo-grade password fondaco-ro-dev).
# Set only when running the app outside compose:
# DATABASE_URL=postgresql://fondaco_ro:fondaco-ro-dev@localhost:5432/fondaco

# Integration tests (skipped when unset). On Windows use 127.0.0.1, not
# localhost (IPv6 stall):
# FONDACO_TEST_DSN=postgresql://fondaco_ro:fondaco-ro-dev@localhost:5432/fondaco
# FONDACO_TEST_ADMIN_DSN=postgresql://fondaco:fondaco-dev@localhost:5432/fondaco

# Planner selection. 'demo' (default) serves pre-generated fixture plans for
# the scripted questions — keyless, no LLM, works out of the box. Set to 'llm'
# to use a real OpenAI-compatible planner via one of the profiles below.
FONDACO_PLANNER=demo

# Planner LLM endpoint (used only when FONDACO_PLANNER=llm) — any
# OpenAI-compatible /chat/completions server. Two documented profiles;
# sampling params are part of the profile.
#
# Profile A — cloud (default planner): omits FONDACO_LLM_TEMPERATURE, because
# claude-sonnet-5 rejects the deprecated `temperature` param.
FONDACO_LLM_BASE_URL=https://api.anthropic.com/v1
FONDACO_LLM_MODEL=claude-sonnet-5
FONDACO_LLM_API_KEY=
# FONDACO_LLM_TEMPERATURE=omit   # unset or "omit" → the param is not sent
#
# Profile B — local fallback (no API key needed; compose default):
# FONDACO_LLM_BASE_URL=http://host.docker.internal:11434/v1
# FONDACO_LLM_MODEL=qwen2.5-coder:7b
# FONDACO_LLM_TEMPERATURE=0      # pinned for reproducibility
# FONDACO_LLM_TIMEOUT_S=180
#
# Switching profiles requires zero code changes (Checkpoint P3).
# Max plan-generation attempts before failing closed:
# FONDACO_LLM_MAX_ATTEMPTS=2

# Egress clearance of the single v0 endpoint (see design/label-model.md §5):
FONDACO_EGRESS_CLEARANCE=internal

# Guards (Phase 5). A value below 1, or one that does not parse, falls back to
# the default rather than to no protection. Any value >= 1 is honored as given,
# including FONDACO_GUARD_K=1, which keeps every group and so switches the
# k-threshold off: it cannot be disabled by accident, but it can on purpose.
# k-threshold: aggregate groups backed by fewer than k rows are dropped.
FONDACO_GUARD_K=5
# Per-session hard cap on executed query steps.
FONDACO_QUERY_BUDGET=20

# Where the append-only, HMAC-sealed audit log is written (file backend). Relative paths are
# resolved against the process working directory, so a containerised deployment
# that does not mount this path loses the log on every restart.
# FONDACO_AUDIT_LOG=./audit.jsonl

# SQL grammar the boundary parses plan templates with: postgres (default),
# duckdb, tsql, bigquery, snowflake. An unknown value denies every plan.
# FONDACO_SQL_DIALECT=postgres

# ── Audit log (boundary/audit.py) ─────────────────────────────────────────
# REQUIRED. HMAC-SHA256 key sealing every audit entry, at least 32 bytes. The
# app refuses to start without it. docker-compose.yml falls back to a published
# dev-only key so the demo starts keyless — that key protects nothing. Generate
# one with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
FONDACO_AUDIT_HMAC_KEY=
# Name of the active key (bound into every entry; default k1). To rotate: give
# the new key a new id and move the old one to the retired list, which is used
# only to verify entries it sealed. Dropping a retired key that still sealed
# entries makes the log unverifiable, and the app refuses to start.
# FONDACO_AUDIT_HMAC_KEY_ID=k1
# FONDACO_AUDIT_HMAC_RETIRED_KEYS=k0:<old key>,kprev:<older key>

# Storage backend: file (default, JSONL at FONDACO_AUDIT_LOG) or postgres.
# The postgres backend writes fondaco_audit.fondaco_audit_log, created by
# demo/dataset/init/04_audit_log.sql; connect as the INSERT+SELECT-only role
# (demo-grade password fondaco-audit-dev, like fondaco_ro).
# FONDACO_AUDIT_BACKEND=postgres
# FONDACO_AUDIT_DSN=postgresql://fondaco_audit:fondaco-audit-dev@db:5432/fondaco

# Anchoring: POST /audit/anchor exports the verified head (seq, mac, key_id)
# to a sink the log's writer cannot rewrite; call it from a scheduler. A file
# sink should live on another volume or host. When set, the latest anchor in
# FONDACO_AUDIT_ANCHOR_FILE must match at startup, or the app refuses to start
# (detects tail truncation, a deleted log, and a rewrite by a key holder).
# FONDACO_AUDIT_ANCHOR_FILE=/anchors/audit-anchors.jsonl
# Or an https webhook; for S3 use a presigned PUT URL with METHOD=PUT.
# FONDACO_AUDIT_ANCHOR_WEBHOOK=https://anchor.example.com/fondaco
# FONDACO_AUDIT_ANCHOR_METHOD=POST

# ── Risk-proportional auto-approval (boundary/approval_policy.py) ─────────
# Off by default: every plan waits for a human. When on, a plan runs without a
# human only if the policy allowed it, its label is <= MAX_LABEL (public or
# internal; restricted is never accepted), every query was fully resolved, and
# the session budget can pay for it. A result with fewer than MIN_ROWS rows
# (after the k-threshold) is held until a human approves its release.
# FONDACO_AUTO_APPROVE_ENABLED=false
# FONDACO_AUTO_APPROVE_MAX_LABEL=internal
# FONDACO_AUTO_APPROVE_MIN_ROWS=10

# ── Reviewed discovery annotations (executor/adapters/annotations.py) ─────
# JSON written by `fondaco discover` and reviewed by the Data Owner. Adds only
# enum_values / business_description, and only to columns the source labels
# public or internal; labels always come from the source comments. An
# unreadable file stops the app at startup.
# FONDACO_SCHEMA_ANNOTATIONS=/config/annotations.json

# ── Source adapter (executor/adapters/factory.py) ─────────────────────────
# postgres (default, DATABASE_URL), sqlserver or bigquery. FONDACO_SQL_DIALECT
# must match: tsql for sqlserver, bigquery for bigquery — else no startup.
# FONDACO_ADAPTER=postgres
# SQL Server (pip install 'fondaco[sqlserver]'); ApplicationIntent=ReadOnly is
# forced. The login's default schema must equal FONDACO_MSSQL_SCHEMA.
# FONDACO_MSSQL_CONNECTION_STRING=Driver={ODBC Driver 18 for SQL Server};Server=erp-db;Database=erp;UID=fondaco_reader;PWD=...;Encrypt=yes
# FONDACO_MSSQL_SCHEMA=dbo
# BigQuery (pip install 'fondaco[bigquery]'); credentials via Application
# Default Credentials (GOOGLE_APPLICATION_CREDENTIALS or workload identity).
# FONDACO_BQ_PROJECT=acme-analytics
# FONDACO_BQ_DATASET=erp
# FONDACO_BQ_MAX_BYTES_BILLED=1000000000
# FONDACO_BQ_LOCATION=EU

# ── JSON API v1 and MCP server (api/mcp_server.py) ────────────────────────
# Bearer token required on /api/v1 when set; give the same value to fondaco-mcp.
# FONDACO_API_TOKEN=
# Where fondaco-mcp reaches the boundary, and the base URL humans open to
# approve (returned to the agent as approval_url).
# FONDACO_API_URL=http://localhost:8000
# FONDACO_PUBLIC_URL=https://fondaco.internal.example

# ── Approval UI sign-in (api/auth.py) ───────────────────────────────────────
# "name:sha256hex" entries from `python -m api.auth new-approver <name>`,
# comma-separated, or one per line in a file. Unset = a one-time token for
# 'admin' is printed to the app log at every start. Malformed = no start.
# FONDACO_APPROVERS=alice:<sha256>,bob:<sha256>
# FONDACO_APPROVERS_FILE=/run/secrets/fondaco_approvers
# Session lifetime in seconds (60 … 604800; anything else → 28800).
# FONDACO_UI_SESSION_TTL_S=28800
# Mark the session cookie Secure (set it when serving over TLS).
# FONDACO_UI_COOKIE_SECURE=true
# Host address compose publishes port 8000 on. Default loopback only.
# FONDACO_BIND_ADDRESS=127.0.0.1
